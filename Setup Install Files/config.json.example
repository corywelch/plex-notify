{
  "twilio": {
    "account_sid": "ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
    "auth_token": "your_auth_token_here",
    "from_number": "+11231231234",
    "to_number": "+11231231234"
  },
  "global_settings": {
    "alert_cooldown_minutes": 60,
    "suppress_minutes_after_failed_retry": 120,
    "retry_backoff_minutes": 15
  },
  "applications": {
    "plex": {
      "enabled": true,
      "process_name": "Plex Media Server",
      "http_health_url": "http://127.0.0.1:32400/identity",
      "auto_restart": true,
      "text_notify": true
    },
    "sabnzbd": {
      "enabled": false,
      "process_name": "SABnzbd",
      "http_health_url": "http://127.0.0.1:8080/api?mode=version",
      "auto_restart": true,
      "text_notify": false
    },
    "radarr": {
      "enabled": false,
      "process_name": "Radarr",
      "http_health_url": "http://127.0.0.1:7878/api/v3/system/status",
      "auto_restart": true,
      "text_notify": false
    },
    "sonarr": {
      "enabled": false,
      "process_name": "Sonarr",
      "http_health_url": "http://127.0.0.1:8989/api/v3/system/status",
      "auto_restart": true,
      "text_notify": false
    },
    "prowlarr": {
      "enabled": false,
      "process_name": "Prowlarr",
      "http_health_url": "http://127.0.0.1:9696/api/v1/system/status",
      "auto_restart": true,
      "text_notify": false
    }
  }
}
